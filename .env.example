# Public origin of this website. Used for canonical URLs, the sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://boctrustmfb.com

# Where the existing Boctrust application lives (login, dashboard, loan form, password reset,
# NIBSS callback, job applications). It must have its own host before this site takes over
# boctrustmfb.com, for example https://app.boctrustmfb.com
NEXT_PUBLIC_LEGACY_APP_URL=https://boctrustmfb.com

# Google Tag Manager container. Leave unset to keep tags off entirely.
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
